{
  "expo": {
    "name": "CourseBell",
    "slug": "coursebell-app",
    "version": "1.0.2",
    "scheme": "coursebell",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.coursebell",
      "buildNumber": "1.0.2",
      "privacyUrl": "https://spearssoftware.com/apps/coursebell/privacy-policy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "edgeToEdgeEnabled": true,
      "package": "app.coursebell"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CourseBell to access your camera to scan QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "sounds": [
            "./assets/sounds/school-bell.wav",
            "./assets/sounds/dinner-bell.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/sonar-alarm.wav",
            "./assets/sounds/classic-alarm.wav",
            "./assets/sounds/melodic-alarm.wav",
            "./assets/sounds/double-beep.wav",
            "./assets/sounds/up-and-down.wav",
            "./assets/sounds/retro-sms.wav",
            "./assets/sounds/soft-triple.wav",
            "./assets/sounds/whistle.wav",
            "./assets/sounds/eight-bit.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
